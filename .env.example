# Application
APP_ENV=development

# gRPC & HTTP
GRPC_PORT=50051
HTTP_PORT=8990

# Database
# DATABASE_PORT di sini = port di host (docker memetakan 5444 -> 5432).
# Di dalam network compose aplikasi tetap memakai 5432.
DATABASE_HOST=localhost
DATABASE_PORT=5444
DATABASE_NAME=pos
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_SSLMODE=disable

# JWT
JWT_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# Docker edge (container fe-app = nginx). Satu-satunya port yang dipublikasikan:
#   /  /api  /ws  /adminer  semuanya lewat port ini.
# Arahkan domain ke http://127.0.0.1:${EDGE_PORT} di server.
# Set EDGE_BIND=0.0.0.0 hanya jika reverse proxy/load balancer domain ada di
# mesin lain — secara default port ini hanya bisa diakses dari server itu sendiri.
EDGE_BIND=127.0.0.1
EDGE_PORT=8990

# TLS di edge (tidak perlu proxy host terpisah).
# Taruh fullchain.pem + privkey.pem di ./certs (atau ubah TLS_CERT_DIR).
# Kalau tidak ada, container membuat sertifikat self-signed (hanya untuk uji).
EDGE_TLS_BIND=127.0.0.1
EDGE_TLS_PORT=443
EDGE_SERVER_NAME=localhost
TLS_CERT_DIR=./certs

# Adminer (http://<domain>/adminer/) dilindungi HTTP Basic Auth.
# WAJIB diisi — tanpa ADMINER_PASSWORD stack menolak start daripada membuka
# database UI tanpa proteksi. Ganti dengan password yang kuat.
ADMINER_USER=admin
ADMINER_PASSWORD=
