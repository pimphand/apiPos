# Application
APP_ENV=development

# gRPC & HTTP
# Port internal container (tidak dipublikasikan ke host).
GRPC_PORT=18733
HTTP_PORT=18734

# Database
# DATABASE_PORT di sini = port di host (docker memetakan 18732 -> 5432).
# Di dalam network compose aplikasi tetap memakai 5432.
DATABASE_HOST=localhost
DATABASE_PORT=18732
DATABASE_NAME=pos
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_SSLMODE=disable

# JWT
# Wajib diisi: minimal 32 byte dan bukan nilai contoh. Generate dengan:
#   openssl rand -base64 48
# Server menolak start bila nilainya kosong, default, atau terlalu pendek.
JWT_SECRET=

# Optional one-time bootstrap. Set all three and use a new username and
# a unique password of 24–72 bytes (e.g. openssl rand -base64 32).
BOOTSTRAP_SUPERADMIN_USERNAME=
BOOTSTRAP_SUPERADMIN_EMAIL=
BOOTSTRAP_SUPERADMIN_PASSWORD=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# Proxy tepercaya untuk rate limit per IP (opsional): daftar IP/CIDR dipisah
# koma, mis. TRUSTED_PROXIES=10.0.0.0/8,192.168.1.10. Header X-Forwarded-For /
# X-Real-IP hanya dibaca bila koneksi datang dari proxy di daftar ini (loopback
# selalu dipercaya karena gateway internal berjalan di host yang sama); di luar
# itu alamat TCP peer yang dipakai sehingga klien tidak bisa memalsukan IP-nya.
TRUSTED_PROXIES=

# Format tanggal & timestamp di response API (layout Go time, bukan strftime).
# Dipakai laporan (mis. kolom date daily-sales, created_at, generated_at) supaya
# semuanya seragam dan tidak menampilkan bentuk RFC3339 "2026-11-17T00:00:00Z".
APP_DATE_FORMAT=2006-01-02
APP_DATETIME_FORMAT=2006-01-02 15:04:05

# Docker edge (container fe-app = nginx). Satu-satunya port yang dipublikasikan:
#   /  /api  /ws  /adminer  semuanya lewat port ini.
# Arahkan domain ke http://127.0.0.1:${EDGE_PORT} di server.
# Set EDGE_BIND=0.0.0.0 hanya jika reverse proxy/load balancer domain ada di
# mesin lain — secara default port ini hanya bisa diakses dari server itu sendiri.
EDGE_BIND=127.0.0.1
EDGE_PORT=18730

# TLS di edge (tidak perlu proxy host terpisah).
# Taruh fullchain.pem + privkey.pem di ./certs (atau ubah TLS_CERT_DIR).
# Kalau tidak ada, container membuat sertifikat self-signed (hanya untuk uji).
EDGE_TLS_BIND=127.0.0.1
EDGE_TLS_PORT=18731

# Semua port host sengaja tidak lazim supaya tidak mudah ditebak/di-fingerprint.
#   18730 edge HTTP   18731 edge HTTPS   18732 PostgreSQL (host)
#   18733 gRPC        18734 gateway HTTP (internal)   18735 docs server
EDGE_SERVER_NAME=localhost
TLS_CERT_DIR=./certs

# Adminer (http://<domain>/adminer/) dilindungi HTTP Basic Auth.
# WAJIB diisi — tanpa ADMINER_PASSWORD stack menolak start daripada membuka
# database UI tanpa proteksi. Ganti dengan password yang kuat.
ADMINER_USER=admin
ADMINER_PASSWORD=
