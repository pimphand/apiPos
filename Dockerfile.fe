# syntax=docker/dockerfile:1

# ---------------------------------------------------------------
# Stage 1: Build the Astro + Vue application
# Frontend source lives in ./fe (see Frontend.md)
# ---------------------------------------------------------------
FROM node:22-alpine AS build

WORKDIR /app

# Install pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

# Cache dependencies
COPY fe/package.json fe/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

# Copy source
COPY fe/ ./

# Build-time public env vars (Astro bakes PUBLIC_* into the static output)
ARG PUBLIC_API_BASE_URL=/api
ARG PUBLIC_APP_NAME=POS
ARG PUBLIC_SESSION_MAX_AGE=2592000
ARG PUBLIC_ADMIN_PATH_PREFIX=
ENV PUBLIC_API_BASE_URL=$PUBLIC_API_BASE_URL \
    PUBLIC_APP_NAME=$PUBLIC_APP_NAME \
    PUBLIC_SESSION_MAX_AGE=$PUBLIC_SESSION_MAX_AGE \
    PUBLIC_ADMIN_PATH_PREFIX=$PUBLIC_ADMIN_PATH_PREFIX

# Build static site
RUN pnpm build

# ---------------------------------------------------------------
# Stage 2: Serve static build behind nginx (with /api proxy + headers)
# ---------------------------------------------------------------
FROM nginx:1.27-alpine AS prod

WORKDIR /usr/share/nginx/html
COPY --from=build /app/dist/ ./

# nginx config: static serving + security headers + /api proxy + cookie handling
COPY Dockerfile.fe.nginx /etc/nginx/conf.d/default.conf

EXPOSE 80

# Wait-until-backend-ready is handled by nginx upstream; container stays served.
CMD ["nginx", "-g", "daemon off;"]
