# Frontend (Astro) nginx configuration for the POS app
# Serves the static build and reverse-proxies /api to the Go gateway.

# Upstream = Go grpc-gateway HTTP server (pos-app, port 18734 inside the shared network)
upstream pos_api {
    server pos-app:18734;
}

# Upstream = Adminer DB UI (internal only, never published on a host port)
upstream adminer_ui {
    server adminer:8080;
}

server {
    listen 80;

    # ---- TLS termination at the edge -----------------------------------
    # Certs come from nginx-tls-certs.sh at container start: real ones mounted at
    # /etc/nginx/certs, otherwise a self-signed pair in /etc/nginx/tls. Plain HTTP
    # keeps working on port 80 (bound to loopback anyway) for local tooling.
    listen 443 ssl;
    http2 on;
    ssl_certificate     /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # ---- Security headers (no loopholes) -------------------------------
    # CSP: default-src 'self' blocks any external/injected remote script.
    #   * `unsafe-inline` (script & style) is required by Vue island runtime
    #     injection (client:only) and Astro view transitions; external origins
    #     are still blocked by default-src 'self', so inline execution of
    #     attacker-supplied remote code is mitigated.
    #   * frame-ancestors 'none' + X-Frame-Options DENY prevent clickjacking.
    #   * connect-src 'self' allows the same-origin /api proxy to the gateway.
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Cross-Origin-Resource-Policy "same-origin" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    # HSTS: enable only after real certificates are mounted (browsers ignore HSTS
    # delivered over an invalid/self-signed connection, and includeSubDomains
    # affects every subdomain).
    # add_header Strict-Transport-Security "max-age=31536000" always;

    # ---- API proxy to Go gateway --------------------------------------
    location /api/ {
        proxy_pass http://pos_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;

        # Allow refresh-token (HttpOnly) cookie to flow through + timeout tune
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
    }

    # ---- Static asset caching ------------------------------------------
    location /_astro/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # ---- Realtime WebSocket proxy to Go gateway ------------------------
    location /ws {
        proxy_pass http://pos_api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # ---- Adminer DB UI (internal service) -------------------------------
    # Reached only through this path: the container has no published port.
    # Adminer >= 4.6 uses X-Forwarded-Prefix so its own links, redirects and
    # cookies stay under /adminer/ instead of pointing at the site root.
    # We always overwrite the header here, so a client cannot spoof it.
    location = /adminer {
        # Relative redirect: keep the client's scheme/host/port (this edge may sit
        # behind the domain proxy on 443, and the edge itself may not be on 80).
        absolute_redirect off;
        return 301 /adminer/;
    }

    location /adminer/ {
        # HTTP Basic Auth (credentials from ADMINER_USER/ADMINER_PASSWORD; the
        # .htpasswd file is generated at container start — see
        # nginx-adminer-auth.sh). Without it the DB UI would be open to anyone
        # who can reach the edge port.
        auth_basic "Adminer";
        auth_basic_user_file /etc/nginx/.htpasswd;

        # Adminer mengirim CSP-nya sendiri; dua CSP di-intersect browser dan bisa
        # memblokir fitur tanpa alasan jelas. Sembunyikan milik upstream supaya
        # hanya CSP edge yang berlaku (satu sumber kebenaran).
        proxy_hide_header Content-Security-Policy;

        proxy_pass http://adminer_ui/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix /adminer;

        # SQL dump import through the UI (nginx default is 1 MB).
        client_max_body_size 64m;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    # ---- Public self-order page (docs/pos-self-order.md) -----------------
    # Pretty form /o/<token> maps to the static order page; the token is read
    # client-side. The query form /o?table=<token> is served by the fallback.
    location /o/ {
        try_files $uri /o/index.html;
    }

    # ---- SPA fallback (Astro static generated paths are real; island routing
    # relies on real paths, so a broad fallback is only for safety) --------
    location / {
        try_files $uri $uri/ /index.html;
    }
}
