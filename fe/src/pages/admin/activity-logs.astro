---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import ModulePlaceholder from '@/components/layout/ModulePlaceholder.vue';
---

<DashboardLayout title="Activity Logs - POS Application">
  <ModulePlaceholder
    client:only="vue"
    title="Activity Logs"
    description="Audit trail of all user actions across the system."
