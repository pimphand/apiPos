---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="POS Application">
  <div class="min-h-screen flex items-center justify-center">
    <div class="text-center">
      <h1 class="text-4xl font-bold mb-4">POS Application</h1>
      <p class="text-muted-foreground mb-8">Point of Sale System</p>
      <a
        href="/login"
        class="inline-flex items-center justify-center px-6 py-3 bg-primary text-primary-foreground rounded-lg hover:bg-primary/90 transition-colors"
      >
        Get Started
      </a>
    </div>
  </div>
</BaseLayout>
