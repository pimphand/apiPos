# ===== Server (Astro dev server) =====
# Host the dev server listens on (0.0.0.0 to expose on the network)
HOST=localhost
# Port the dev server listens on
PORT=4000

# ===== Frontend app (exposed to the browser via import.meta.env.PUBLIC_*) =====
# Application name shown in the UI
PUBLIC_APP_NAME=POS
# Base path for all API requests made by the browser
PUBLIC_API_BASE_URL=/api
# Session/refresh token max age in seconds
PUBLIC_SESSION_MAX_AGE=2592000

# ===== Backend API =====
# Target for the Vite dev proxy. All requests to /api/* are forwarded here.
# POS backend exposes the HTTP gateway on port 8990.
PUBLIC_API_URL=http://localhost:8990